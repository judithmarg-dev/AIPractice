# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Next.js build output ──────────────────────────────────────────────────────
# Generated on every `next dev` / `next build` — never commit.
.next/
out/

# ── Environment variables ─────────────────────────────────────────────────────
# .env.local holds secrets (Supabase keys). Keep .env.local.example committed.
.env
.env.local
.env.*.local

# ── TypeScript / build artefacts ─────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Editor & OS ───────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc ─────────────────────────────────────────────────────────────────────
dist/
dist-ssr/
